{
  "name": "boxy-bird",
  "version": "1.0.0",
  "description": "Flappy bird clone where the bird is a box with an Amazon smile",
  "main": "main.js",
  "scripts": {
    "start": "open index.html",
    "build": "node build.mjs",
    "assets": "node make-icon.mjs",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npm run ios:sync && npx cap open ios",
    "test": "node --test"
  },
  "keywords": ["boxy-bird", "flappy-bird", "flappy-bird-clone", "ios", "game", "arcade-game", "mobile-game", "canvas", "html5-canvas", "javascript", "web-audio", "capacitor"],
  "author": "mehfuzh",
  "license": "Apache-2.0",
  "type": "commonjs",
  "devDependencies": {
    "@capacitor/assets": "^3.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0"
  }
}
